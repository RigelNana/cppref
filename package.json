{
  "name": "cppreference-fumadocs",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --cwd apps/docs build",
    "dev": "bun run --cwd apps/docs dev",
    "extract": "bun run packages/migrate/src/cli.ts extract",
    "render": "bun run packages/migrate/src/cli.ts render",
    "golden": "bun run packages/migrate/src/cli.ts golden",
    "migrate:direct": "bun run packages/migrate/src/cli.ts direct",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.28",
    "@ai-sdk/openai": "^4.0.41",
    "@earendil-works/pi-agent-core": "^0.84.1",
    "@earendil-works/pi-ai": "^0.84.1",
    "ai": "^7.0.62",
    "parse5": "^8.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^6.0.3"
  }
}
