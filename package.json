{
  "name": "cppreference-astro",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --cwd apps/docs build",
    "dev": "bun run --cwd apps/docs dev",
    "check": "bun run --cwd apps/docs check",
    "preview": "bun run --cwd apps/docs preview",
    "extract": "bun run packages/migrate/src/cli.ts extract",
    "render": "bun run packages/migrate/src/cli.ts render",
    "golden": "bun run packages/migrate/src/cli.ts golden",
    "migrate:prepare": "bun run packages/migrate/src/cli.ts prepare-external",
    "validate:mdx": "bun run packages/migrate/src/cli.ts validate-mdx",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "parse5": "^8.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^6.0.3"
  }
}
