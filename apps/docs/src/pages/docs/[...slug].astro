---
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import { mdxComponents } from "@/components/mdx";
import DocsLayout from "@/layouts/DocsLayout.astro";
import { adjacentPages, breadcrumbsFor, buildNavigation } from "@/lib/navigation";
import { docRoute } from "@/lib/urls";

interface Props {
  entry: CollectionEntry<"docs">;
}

export async function getStaticPaths() {
  const entries = await getCollection("docs");
  const ids = new Set(entries.map((entry) => entry.id));
  return entries.filter((entry) => entry.id !== "index").map((entry) => ({
    params: { slug: docRoute(entry.id, ids) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const entries = await getCollection("docs");
const ids = new Set(entries.map((item) => item.id));
const navigation = buildNavigation(entries);
const breadcrumbs = breadcrumbsFor(navigation, entry.id);
const { next, previous } = adjacentPages(navigation, entry.id, ids);
const { Content, headings } = await render(entry);
---

<DocsLayout
  breadcrumbs={breadcrumbs}
  currentId={entry.id}
  description={entry.data.description}
  headings={headings}
  navigation={navigation}
  next={next}
  previous={previous}
  sourceUrl={entry.data.source_url}
  title={entry.data.title}
>
  <Content components={mdxComponents} />
</DocsLayout>
