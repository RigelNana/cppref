---
import { ClientRouter } from "astro:transitions";
import { ArrowRight, Braces, Moon, Sun } from "lucide-astro";
import referenceDirectory from "@/lib/reference-directory.json";
import { withBase } from "@/lib/urls";
import "@/styles/global.css";

interface DirectoryLink {
  href?: string;
  label: string;
  revision?: string;
}

interface RequiredDirectoryLink extends DirectoryLink {
  href: string;
}

interface DirectoryGroup {
  heading: DirectoryLink;
  links?: RequiredDirectoryLink[];
}

interface DirectorySection {
  columns: DirectoryGroup[][];
  compilerSupport: {
    standards: RequiredDirectoryLink[];
    title: RequiredDirectoryLink;
  };
  footer: RequiredDirectoryLink[];
  standards: DirectoryLink[];
  technical: DirectoryGroup[];
  technicalTitle: RequiredDirectoryLink;
  title: RequiredDirectoryLink;
}

const sections = referenceDirectory as DirectorySection[];
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Modern C and C++ reference documentation migrated from cppreference." />
    <meta name="viewport" content="width=device-width" />
    <title>C and C++ reference · cppreference modern</title>
    <ClientRouter />
    <script is:inline>
      const savedTheme = localStorage.getItem("cppref-theme");
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      document.documentElement.classList.toggle("dark", savedTheme ? savedTheme === "dark" : prefersDark);
    </script>
  </head>
  <body>
    <main class="home">
      <header class="home-header">
        <a class="brand" href={withBase("/")}><Braces aria-hidden="true" /><span>cppreference</span></a>
        <nav aria-label="Primary">
          <a href={withBase("/docs")}>Documentation</a>
          <button class="icon-button theme-toggle" data-theme-toggle aria-label="Toggle color theme">
            <Sun class="theme-icon theme-icon--sun" aria-hidden="true" />
            <Moon class="theme-icon theme-icon--moon" aria-hidden="true" />
          </button>
        </nav>
      </header>

      <section class="home-hero">
        <span>C · C++ · Standard library</span>
        <h1>C and C++ reference documentation</h1>
        <p>Modern documentation migrated from cppreference without changing the technical content.</p>
        <a class="home-cta" href={withBase("/docs")}>
          Open documentation
          <ArrowRight aria-hidden="true" />
        </a>
      </section>

      <section class="reference-sections" aria-label="Reference">
        {
          sections.map((section) => (
            <section class="reference-table" aria-label={section.title.label}>
              <header>
                <h2><a href={withBase(section.title.href)}>{section.title.label}</a></h2>
                <div class="edition-links">
                  <p>
                    {section.standards.map((standard, index) => (
                      <>
                        {index > 0 && <span aria-hidden="true">, </span>}
                        {standard.href
                          ? <a href={withBase(standard.href)}>{standard.label}</a>
                          : <span>{standard.label}</span>}
                      </>
                    ))}
                  </p>
                  <span class="edition-divider" aria-hidden="true">·</span>
                  <p>
                    <a href={withBase(section.compilerSupport.title.href)}>{section.compilerSupport.title.label}</a>
                    {section.compilerSupport.standards.length > 0 && <span aria-hidden="true">: </span>}
                    {section.compilerSupport.standards.map((standard, index) => (
                      <>
                        {index > 0 && <span aria-hidden="true">, </span>}
                        <a href={withBase(standard.href)}>{standard.label}</a>
                      </>
                    ))}
                  </p>
                </div>
              </header>

              <div class="reference-grid">
                {section.columns.map((column) => (
                  <div class="reference-column">
                    {column.map((group) => (
                      <section class="reference-group">
                        <h3>
                          {group.heading.href
                            ? <a href={withBase(group.heading.href)}>{group.heading.label}</a>
                            : group.heading.label}
                          {group.heading.revision && <span class="revision-label">{group.heading.revision}</span>}
                        </h3>
                        {group.links && group.links.length > 0 && (
                          <ul>
                            {group.links.map((item) => (
                              <li>
                                <a href={withBase(item.href)}>{item.label}</a>
                                {item.revision && <span class="revision-label">{item.revision}</span>}
                              </li>
                            ))}
                          </ul>
                        )}
                      </section>
                    ))}
                  </div>
                ))}
              </div>

              <section class="technical-directory">
                <h3><a href={withBase(section.technicalTitle.href)}>{section.technicalTitle.label}</a></h3>
                <div>
                  {section.technical.map((group) => (
                    <p>
                      {group.heading.href
                        ? <a href={withBase(group.heading.href)}>{group.heading.label}</a>
                        : group.heading.label}
                      {group.heading.revision && <span class="revision-label">{group.heading.revision}</span>}
                      {group.links?.map((item) => (
                        <>
                          <span aria-hidden="true"> · </span>
                          <a href={withBase(item.href)}>{item.label}</a>
                          {item.revision && <span class="revision-label">{item.revision}</span>}
                        </>
                      ))}
                    </p>
                  ))}
                </div>
              </section>

              <footer>
                {section.footer.map((item, index) => (
                  <>
                    {index > 0 && <span aria-hidden="true"> · </span>}
                    <a href={withBase(item.href)}>{item.label}</a>
                  </>
                ))}
              </footer>
            </section>
          ))
        }
      </section>
    </main>

    <script>
      import "@/scripts/shell";
    </script>
  </body>
</html>

<style>
  .home {
    min-height: 100vh;
  }

  .home-header,
  .home-hero,
  .reference-sections {
    width: min(100% - 2rem, 64rem);
    margin-inline: auto;
  }

  .home-header {
    display: flex;
    min-height: 4rem;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--line);
  }

  .home-header nav {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .home-header nav > a {
    color: var(--muted);
    font-size: 0.82rem;
    font-weight: 650;
    text-decoration: none;
  }

  .home-header nav > a:hover {
    color: var(--foreground);
  }

  .home-hero {
    padding-block: clamp(4.5rem, 9vw, 7.5rem);
  }

  .home-hero > span {
    display: block;
    margin-bottom: 0.9rem;
    color: var(--primary);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .home-hero h1 {
    max-width: 15ch;
    margin: 0;
    font-size: clamp(2.65rem, 7vw, 5rem);
    font-weight: 730;
    line-height: 0.98;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .home-hero p {
    max-width: 36rem;
    margin: 1.6rem 0 0;
    color: var(--muted);
    font-size: 1.08rem;
    line-height: 1.65;
  }

  .home-cta {
    display: inline-flex;
    height: 2.7rem;
    align-items: center;
    gap: 0.55rem;
    margin-top: 2rem;
    padding-inline: 1rem;
    border-radius: var(--radius-sm);
    color: var(--background);
    background: var(--foreground);
    font-size: 0.82rem;
    font-weight: 750;
    text-decoration: none;
  }

  .home-cta:hover {
    color: var(--background);
    background: color-mix(in oklab, var(--foreground) 86%, var(--primary));
  }

  .home-cta svg {
    width: 1rem;
    height: 1rem;
  }

  .reference-sections {
    display: grid;
    gap: 2.5rem;
    padding-bottom: 5rem;
  }

  .reference-table {
    border: 1px solid var(--line);
  }

  .reference-table > header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding: 1rem 1.3rem;
    border-bottom: 1px solid var(--line);
  }

  .reference-table h2 {
    margin: 0;
    font-size: 0.95rem;
  }

  .reference-table h2 a {
    color: inherit;
    text-decoration: none;
  }

  .edition-links {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.55rem;
  }

  .reference-table header p {
    margin: 0;
    color: var(--muted);
    font-size: 0.76rem;
  }

  .edition-divider {
    color: var(--line-strong);
  }

  .reference-table a {
    text-underline-offset: 0.18em;
  }

  .reference-table a:hover {
    color: var(--primary);
  }

  .reference-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .reference-column {
    display: grid;
    align-content: start;
    gap: 1.35rem;
    padding: 1.25rem 1.3rem;
  }

  .reference-column + .reference-column {
    border-left: 1px solid var(--line);
  }

  .reference-group h3,
  .technical-directory h3 {
    margin: 0;
    color: var(--muted);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .reference-group h3 a,
  .technical-directory h3 a {
    color: inherit;
    text-decoration: none;
  }

  .reference-group ul {
    display: grid;
    gap: 0.26rem;
    margin: 0.6rem 0 0;
    padding: 0;
    list-style: none;
  }

  .reference-group li,
  .reference-group a,
  .technical-directory p,
  .reference-table footer {
    font-size: 0.8rem;
    line-height: 1.45;
  }

  .reference-group li > a,
  .technical-directory p > a {
    text-decoration: none;
  }

  .revision-label {
    margin-left: 0.32rem;
    color: var(--muted);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
    white-space: nowrap;
  }

  .technical-directory {
    padding: 1rem 1.3rem;
    border-top: 1px solid var(--line);
  }

  .technical-directory > div {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.35rem 1.5rem;
    margin-top: 0.65rem;
  }

  .technical-directory p {
    margin: 0;
  }

  .reference-table footer {
    padding: 0.8rem 1.3rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
  }

  .reference-table footer a {
    color: inherit;
  }

  @media (max-width: 700px) {
    .home-hero {
      padding-block: 4rem;
    }

    .reference-grid,
    .technical-directory > div {
      grid-template-columns: 1fr;
    }

    .reference-column + .reference-column {
      border-top: 1px solid var(--line);
      border-left: 0;
    }
  }
</style>
