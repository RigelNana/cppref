---
import { ChevronRight } from "lucide-astro";
import type { NavNode } from "@/lib/navigation";
import { withBase } from "@/lib/urls";

interface Props {
  currentId: string;
  depth?: number;
  nodes: NavNode[];
}

const { currentId, depth = 0, nodes } = Astro.props;
---

<ul class:list={["nav-tree", `nav-tree--depth-${depth}`]}>
  {
    nodes.map((node) => {
      const active = currentId === node.id || currentId === `${node.id}/index` || currentId.startsWith(`${node.id}/`);
      const current = currentId === node.id || currentId === `${node.id}/index`;
      if (node.kind === "page") {
        return (
          <li>
            <a class:list={["nav-link", { "is-current": current }]} href={withBase(node.href ?? "/docs")} aria-current={current ? "page" : undefined}>
              {node.title}
            </a>
          </li>
        );
      }


      const childNodes = node.children ?? [];
      if (childNodes.length === 0) {
        return (
          <li>
            {
              node.href ? (
                <a class:list={["nav-link", { "is-current": current }]} href={withBase(node.href)} aria-current={current ? "page" : undefined}>
                  {node.title}
                </a>
              ) : (
                <span class="nav-link">{node.title}</span>
              )
            }
          </li>
        );
      }


      return (
        <li>
          <details class="nav-folder" open={active || depth === 0}>
            <summary class:list={["nav-summary", { "is-current": current }]}>
              {
                node.href ? (
                  <a class="nav-folder-link" href={withBase(node.href)} aria-current={current ? "page" : undefined}>
                    {node.title}
                  </a>
                ) : (
                  <span>{node.title}</span>
                )
              }
              <ChevronRight aria-hidden="true" />
            </summary>
            {childNodes.length > 0 && <Astro.self currentId={currentId} depth={depth + 1} nodes={childNodes} />}
          </details>
        </li>
      );
    })
  }
</ul>
