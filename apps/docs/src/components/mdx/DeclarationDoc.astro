---
import { revisionLabel, type RevisionRange } from "@/lib/revisions";

interface Props extends RevisionRange {
  id?: number;
}

const { id, removed, since, until } = Astro.props;
const label = since || until || removed ? revisionLabel({ removed, since, until }) : undefined;
---

<section class="cpp-declaration-doc" data-declaration-id={id}>
  {label && <div class="cpp-declaration cpp-declaration--revision"><span class="cpp-declaration__id">{label}</span></div>}
  <slot />
</section>
