---
import { withBase } from "@/lib/urls";

interface Props {
  dest: string;
  section?: string;
}

const { dest, section } = Astro.props;
const normalizedDest = dest.replace(/^\/?(?:docs\/)?/u, "");
const href = withBase(`/docs/${normalizedDest}${section ? `#${section}` : ""}`);
---

<a class="cpp-doc-link" href={href}><slot /></a>
