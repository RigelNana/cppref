---
import { Search } from "lucide-astro";
import { withBase } from "@/lib/urls";

const searchUrl = withBase("/search.json");
---

<div class="doc-search" data-doc-search data-search-url={searchUrl}>
  <Search aria-hidden="true" />
  <input aria-label="Search documentation" autocomplete="off" placeholder="Search" type="search" />
  <kbd>Ctrl K</kbd>
  <div class="doc-search__results" hidden></div>
</div>

<script>
  interface SearchEntry {
    description: string;
    href: string;
    title: string;
  }

  let index: Promise<SearchEntry[]> | undefined;

  function currentRoot(): HTMLElement | null {
    return document.querySelector<HTMLElement>("[data-doc-search]");
  }

  function closeResults(root = currentRoot()): void {
    const results = root?.querySelector<HTMLElement>(".doc-search__results");
    if (results) results.hidden = true;
  }

  async function loadIndex(root: HTMLElement): Promise<SearchEntry[]> {
    if (!root.dataset.searchUrl) return [];
    index ??= fetch(root.dataset.searchUrl).then((response) => response.json() as Promise<SearchEntry[]>);
    return index;
  }

  document.addEventListener("input", async (event) => {
    if (!(event.target instanceof HTMLInputElement)) return;
    const input = event.target;
    const root = input.closest<HTMLElement>("[data-doc-search]");
    const results = root?.querySelector<HTMLElement>(".doc-search__results");
    if (!root || !results) return;
    const query = input.value.trim().toLocaleLowerCase();
    if (query.length < 2) {
      closeResults(root);
      return;
    }
    const entries = await loadIndex(root);
    if (!input.isConnected || input.value.trim().toLocaleLowerCase() !== query) return;
    const matches = entries
      .filter((entry) => `${entry.title} ${entry.description}`.toLocaleLowerCase().includes(query))
      .slice(0, 10);
    results.replaceChildren();
    for (const entry of matches) {
      const link = document.createElement("a");
      const title = document.createElement("strong");
      const description = document.createElement("span");
      link.href = entry.href;
      title.textContent = entry.title;
      description.textContent = entry.description;
      link.append(title, description);
      results.append(link);
    }
    if (matches.length === 0) {
      const empty = document.createElement("p");
      empty.textContent = "No matching documentation";
      results.append(empty);
    }
    results.hidden = false;
  });

  document.addEventListener("keydown", (event) => {
    const root = currentRoot();
    const input = root?.querySelector<HTMLInputElement>("input");
    if ((event.ctrlKey || event.metaKey) && event.key.toLocaleLowerCase() === "k") {
      event.preventDefault();
      input?.focus();
    }
    if (event.key === "Escape") closeResults(root);
  });

  document.addEventListener("pointerdown", (event) => {
    const root = currentRoot();
    if (root && event.target instanceof Node && !root.contains(event.target)) closeResults(root);
  });
</script>
