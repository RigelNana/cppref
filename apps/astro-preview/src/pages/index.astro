---
import { ArrowRight, Braces, Moon, Sun } from "lucide-astro";
import { withBase } from "@/lib/urls";
import "@/styles/global.css";

type LinkItem = readonly [label: string, href: string];
type TableCell = { links: readonly LinkItem[]; title: string };

const cppLanguage: TableCell = {
  title: "Language",
  links: [
    ["Preprocessor", "/docs/cpp/language/preprocessor"],
    ["Keywords", "/docs/cpp/language/keywords"],
    ["ASCII chart", "/docs/cpp/language/ascii"],
    ["Basic concepts", "/docs/cpp/language/basic_concepts"],
    ["Comments", "/docs/cpp/language/basic_concepts/comments"],
    ["Names", "/docs/cpp/language/basic_concepts/name"],
    ["Types", "/docs/cpp/language/basic_concepts/types"],
    ["The main function", "/docs/cpp/language/basic_concepts/main_function"],
    ["Expressions", "/docs/cpp/language/expressions"],
    ["Statements", "/docs/cpp/language/statements"],
    ["Declarations", "/docs/cpp/language/declarations"],
    ["Classes", "/docs/cpp/language/classes"],
    ["Templates", "/docs/cpp/language/templates"],
    ["Exceptions", "/docs/cpp/language/exceptions"],
    ["Initialization", "/docs/cpp/language/initialization"],
    ["Functions", "/docs/cpp/language/functions"],
    ["History", "/docs/cpp/language/history"],
  ],
};

const cppLibrary: TableCell = {
  title: "Standard library",
  links: [
    ["Chrono library", "/docs/cpp/library/chrono"],
    ["`duration`", "/docs/cpp/library/chrono/duration"],
    ["`time_point`", "/docs/cpp/library/chrono/time_point"],
    ["`year_month_day`", "/docs/cpp/library/chrono/year_month_day"],
    ["`zoned_time`", "/docs/cpp/library/chrono/zoned_time"],
    ["`<chrono>` header", "/docs/cpp/library/headers/chrono"],
  ],
};

const cppMore: TableCell = {
  title: "Other",
  links: [
    ["Acronyms", "/docs/cpp/language/acronyms"],
    ["Extending std", "/docs/cpp/language/extending_std"],
    ["RAII", "/docs/cpp/language/raii"],
    ["Pimpl", "/docs/cpp/language/pimpl"],
    ["Rule of three", "/docs/cpp/language/rule_of_three"],
    ["Zero-overhead principle", "/docs/cpp/language/Zero-overhead_principle"],
    ["Template metaprogramming", "/docs/cpp/language/template_metaprogramming"],
  ],
};

const cLanguage: TableCell = { title: "Language", links: [["C reference", "/docs/c"]] };
const cString: TableCell = { title: "String library", links: [["memcpy", "/docs/c/string/byte/memcpy"]] };
const cppStandards = [
  ["C++11", "/docs/cpp/language/11"],
  ["C++14", "/docs/cpp/language/14"],
  ["C++17", "/docs/cpp/language/17"],
  ["C++20", "/docs/cpp/language/20"],
  ["C++23", "/docs/cpp/language/23"],
  ["C++26", "/docs/cpp/language/26"],
] as const;

const sections = [
  { cells: [cppLanguage, cppLibrary, cppMore], standards: cppStandards, title: "C++ reference" },
  { cells: [cLanguage, cString], standards: undefined, title: "C reference" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Modern C and C++ reference documentation migrated from cppreference." />
    <meta name="viewport" content="width=device-width" />
    <title>C and C++ reference · cppreference modern</title>
    <script is:inline>
      const savedTheme = localStorage.getItem("cppref-theme");
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      document.documentElement.classList.toggle("dark", savedTheme ? savedTheme === "dark" : prefersDark);
    </script>
  </head>
  <body>
    <main class="home">
      <header class="home-header">
        <a class="brand" href={withBase("/")}><Braces aria-hidden="true" /><span>cppreference</span></a>
        <nav aria-label="Primary">
          <a href={withBase("/docs")}>Documentation</a>
          <button class="icon-button theme-toggle" data-theme-toggle aria-label="Toggle color theme">
            <Sun class="theme-icon theme-icon--sun" aria-hidden="true" />
            <Moon class="theme-icon theme-icon--moon" aria-hidden="true" />
          </button>
        </nav>
      </header>

      <section class="home-hero">
        <span>C · C++ · Standard library</span>
        <h1>C and C++ reference documentation</h1>
        <p>Modern documentation migrated from cppreference without changing the technical content.</p>
        <a class="home-cta" href={withBase("/docs")}>
          Open documentation
          <ArrowRight aria-hidden="true" />
        </a>
      </section>

      <section class="reference-sections" aria-label="Reference">
        {
          sections.map((section) => (
            <section class="reference-table" aria-label={section.title}>
              <header>
                <h2>{section.title}</h2>
                {section.standards && (
                  <p>
                    {section.standards.map(([standard, href], index) => (
                      <>
                        {index > 0 && <span aria-hidden="true">, </span>}
                        <a href={withBase(href)}>{standard}</a>
                      </>
                    ))}
                  </p>
                )}
              </header>
              <div class="reference-grid">
                {section.cells.map((cell) => (
                  <div>
                    <h3>{cell.title}</h3>
                    <ul>
                      {cell.links.map(([label, href]) => <li><a href={withBase(href)}>{label}</a></li>)}
                    </ul>
                  </div>
                ))}
              </div>
            </section>
          ))
        }
      </section>
    </main>

    <script>
      document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
        const dark = !document.documentElement.classList.contains("dark");
        document.documentElement.classList.toggle("dark", dark);
        localStorage.setItem("cppref-theme", dark ? "dark" : "light");
      });
    </script>
  </body>
</html>

<style>
  .home {
    min-height: 100vh;
  }

  .home-header,
  .home-hero,
  .reference-sections {
    width: min(100% - 2rem, 64rem);
    margin-inline: auto;
  }

  .home-header {
    display: flex;
    min-height: 4rem;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--line);
  }

  .home-header nav {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .home-header nav > a {
    color: var(--muted);
    font-size: 0.82rem;
    font-weight: 650;
    text-decoration: none;
  }

  .home-header nav > a:hover {
    color: var(--foreground);
  }

  .home-hero {
    padding-block: clamp(4.5rem, 9vw, 7.5rem);
  }

  .home-hero > span {
    display: block;
    margin-bottom: 0.9rem;
    color: var(--primary);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .home-hero h1 {
    max-width: 15ch;
    margin: 0;
    font-size: clamp(2.65rem, 7vw, 5rem);
    font-weight: 730;
    line-height: 0.98;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .home-hero p {
    max-width: 36rem;
    margin: 1.6rem 0 0;
    color: var(--muted);
    font-size: 1.08rem;
    line-height: 1.65;
  }

  .home-cta {
    display: inline-flex;
    height: 2.7rem;
    align-items: center;
    gap: 0.55rem;
    margin-top: 2rem;
    padding-inline: 1rem;
    border-radius: var(--radius-sm);
    color: var(--background);
    background: var(--foreground);
    font-size: 0.82rem;
    font-weight: 750;
    text-decoration: none;
  }

  .home-cta:hover {
    color: var(--background);
    background: color-mix(in oklab, var(--foreground) 86%, var(--primary));
  }

  .home-cta svg {
    width: 1rem;
    height: 1rem;
  }

  .reference-sections {
    display: grid;
    gap: 2.5rem;
    padding-bottom: 5rem;
  }

  .reference-table {
    border: 1px solid var(--line);
  }

  .reference-table > header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 1rem;
    padding: 1rem 1.3rem;
    border-bottom: 1px solid var(--line);
  }

  .reference-table h2 {
    margin: 0;
    font-size: 0.95rem;
  }

  .reference-table header p {
    margin: 0;
    color: var(--muted);
    font-size: 0.78rem;
  }

  .reference-table a {
    text-underline-offset: 0.18em;
  }

  .reference-table a:hover {
    color: var(--primary);
  }

  .reference-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .reference-grid > div {
    padding: 1.25rem 1.3rem;
  }

  .reference-grid > div + div {
    border-left: 1px solid var(--line);
  }

  .reference-grid h3 {
    margin: 0;
    color: var(--muted);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .reference-grid ul {
    display: grid;
    gap: 0.3rem;
    margin: 0.8rem 0 0;
    padding: 0;
    list-style: none;
  }

  .reference-grid li,
  .reference-grid a {
    font-size: 0.82rem;
    line-height: 1.45;
  }

  .reference-grid a {
    text-decoration: none;
  }

  @media (max-width: 700px) {
    .home-hero {
      padding-block: 4rem;
    }

    .reference-grid {
      grid-template-columns: 1fr;
    }

    .reference-grid > div + div {
      border-top: 1px solid var(--line);
      border-left: 0;
    }
  }
</style>
