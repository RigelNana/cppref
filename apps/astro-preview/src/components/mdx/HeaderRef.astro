---
import { withBase } from "@/lib/urls";

interface Props {
  displayName?: string;
  language: "C" | "C++";
  name: string;
}

const { displayName, language, name } = Astro.props;
const segment = language === "C" ? "c" : "cpp";
const href = withBase(`/docs/${segment}/header/${name.replace(/[<>]/gu, "")}`);
---

<a class="cpp-header-ref" href={href}><code>{displayName ?? name}</code></a>
