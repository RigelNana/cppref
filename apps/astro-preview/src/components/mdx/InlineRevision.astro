---
import { revisionLabel, type RevisionRange } from "@/lib/revisions";
import RevisionMark from "./RevisionMark.astro";

const { removed, since, until } = Astro.props as RevisionRange;
---

<span class="cpp-inline-revision">
  <span class="cpp-inline-revision__range">
    <span class="cpp-inline-revision__content"><slot /></span>
    <RevisionMark class="cpp-inline-revision__mark" icon={false}>{revisionLabel({ removed, since, until })}</RevisionMark>
  </span>
</span>
