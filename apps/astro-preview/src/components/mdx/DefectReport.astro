---
import PaperLink from "./PaperLink.astro";

interface Props {
  id: number | string;
  kind: "cwg" | "lwg" | "paper";
  standard: string;
}

const { id, kind, standard } = Astro.props;
const label = kind === "paper" ? String(id) : `${kind.toUpperCase()} ${id}`;
---

<article class="cpp-defect-report">
  <div class="cpp-defect-report__meta">
    {kind === "paper" ? <PaperLink paper={String(id)}>{label}</PaperLink> : <strong>{label}</strong>}
    <div>{standard}</div>
  </div>
  <div class="cpp-defect-report__change"><slot /></div>
</article>
