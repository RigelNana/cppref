{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": ["bun"]
    ,"paths": {
      "@cppref/page-ir": ["./packages/page-ir/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "tests/**/*.ts"]
}
